# ============================================================================
# SiDoel — .htaccess folder upload gambar (admin/assets/img)
# Folder ini hanya berisi gambar. Cegah eksekusi skrip yang mungkin ikut
# terunggah (php, phtml, cgi, dll.) agar tidak bisa dijalankan dari web.
# Berlaku juga untuk subfolder: foto_siswa/, foto_guru/, kop/, logo/.
# ============================================================================

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<FilesMatch "(?i)\.(php|php3|php4|php5|php7|php8|phtml|phps|phar|pl|py|cgi|sh|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ============================================================================
# SiDoel — .htaccess folder admin/
# Proteksi tambahan khusus area admin:
#   - dump database (admin/backup/) tidak boleh diunduh langsung
#   - tanpa directory listing
# ============================================================================

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir seluruh isi folder backup (dump .sql hasil fitur Backup & Restore)
    RewriteRule ^backup(/|$) - [F,L]

    # Blokir akses web ke dependensi Composer (tetap bisa di-require oleh PHP)
    RewriteRule ^vendor(/|$) - [F,L]

    # Blokir file log/arsip di area admin
    RewriteRule \.(sql|log|bak|orig|zip|rar|7z)$ - [F,L,NC]
</IfModule>

# Lapisan kedua bila mod_rewrite tidak aktif
<IfModule mod_alias.c>
    RedirectMatch 404 (?i)^.*/admin/(backup|vendor)(/|$)
</IfModule>

<FilesMatch "(?i)\.(sql|log|bak|orig|zip|rar|7z)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

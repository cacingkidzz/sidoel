# ============================================================================
# SiDoel — .gitignore
# Aplikasi: PHP native (mysqli) + Bootstrap 5 / AdminLTE 4
# Repo ini berisi KODE saja. Data (DB dump), upload user, dan dependensi
# Composer tidak di-commit.
# ============================================================================

# --- Dependensi Composer ----------------------------------------------------
# Jangan di-commit. Di server: `composer install --no-dev` (lihat .cpanel.yml)
# atau unggah folder vendor/ sekali lewat File Manager.
admin/vendor/

# --- Konfigurasi produksi (RAHASIA) ----------------------------------------
# File ini berisi kredensial DB / API key server dan DIBACA OTOMATIS oleh
# admin/koneksi.php bila ada. Buat manual di server, jangan pernah di-commit.
admin/koneksi.local.php
.env
.env.*
!.env.example
config.local.php

# --- Backup database (fitur Backup & Restore) ------------------------------
admin/backup/

# --- Dump / skrip SQL ------------------------------------------------------
# Schema & dump data (data_backup*.sql, spp.sql, jadwal_smk.sql, dst.)
# diimpor lewat phpMyAdmin, bukan lewat git.
*.sql
*.sql.gz
**/*.sql

# --- Upload user (foto, kop, logo) ----------------------------------------
# File di dalam folder ini milik sekolah; jangan ditimpa/di-commit.
# Folder dibuat otomatis oleh .cpanel.yml saat deploy.
admin/assets/img/foto_siswa/*
admin/assets/img/foto_guru/*

# --- Log & cache -----------------------------------------------------------
*.log
error_log
php_errorlog
admin/*.log
admin/backup/*.log
*.cache
.cache/

# --- File sementara / arsip ------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
*.swp
*.swo
*~
*.zip
*.rar
*.7z

# --- OS & editor -----------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
nbproject/

# --- Node (tidak dipakai, jaga-jaga) --------------------------------------
node_modules/
package-lock.json

# --- CATATAN ---------------------------------------------------------------
# Yang HARUS tetap di-commit:
#   .cpanel.yml, admin/composer.json, admin/composer.lock, AGENTS.md,
#   seluruh kode PHP, CSS/JS, dan gambar bawaan (pria.png, wanita.png, logo).
